# Configure these variables in Vercel. Do not commit real API keys.
RESEND_API_KEY=re_replace_with_your_key
QUOTE_TO_EMAIL=uniquecashforcars@gmail.com
QUOTE_FROM_EMAIL=Unique Cash for Cars <onboarding@resend.dev>

# Optional overrides for the public Google Ads identifiers used by the site.
# The phone label must be for Google's connected website-call measurement.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-replace_with_your_id
NEXT_PUBLIC_GOOGLE_ADS_FORM_CONVERSION_LABEL=replace_with_form_label
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=replace_with_phone_label
