# Configure these variables in Vercel. Do not commit real API keys.
# Scope all delivery/database credentials to PRODUCTION ONLY.
# Other environments simulate form validation without storage or delivery.
# Live capture and cron require VERCEL_ENV=production (set by Vercel).
#
# Quote delivery — pick ONE of:
#   QUOTE_WEBHOOK_URL                         → Zapier / Make / CRM
#   RESEND_API_KEY + QUOTE_TO_EMAIL           → email via Resend
RESEND_API_KEY=re_replace_with_your_key
# The production key must permit GET /emails/:id for receipt reconciliation.
QUOTE_TO_EMAIL=info@apluscarremoval.com.au
# Must be a domain you have verified in Resend. The onboarding address only
# works for Resend's own sandbox testing.
QUOTE_FROM_EMAIL=Unique Cash for Cars <quotes@uniquecashforcars.com.au>

# Durable lead storage and scheduled retry processing.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
CRON_SECRET=replace_with_at_least_32_random_bytes

# Optional. Leave unset to use the production Google Ads and GA4 IDs baked into
# src/components/GoogleAdsTracking.tsx. Only set these if you need to point at
# different measurement properties. Invalid placeholders disable that specific
# destination because they fail the ID validation.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-750701638
# NEXT_PUBLIC_GOOGLE_ADS_FORM_CONVERSION_LABEL=PXg6CPz39usBEMaY--UC
# NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=sF8gCNG54ZgBEMaY--UC
# NEXT_PUBLIC_GA4_ID=G-VZT8S8WXDH
