{
  "name": "unique",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:urls && npm test",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.4.2",
    "@types/mdx": "^2.0.14",
    "next": "16.4.2",
    "postcss": "8.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "es-abstract": "^1.24.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  },
  "engines": {
    "node": "24.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.8"
}
