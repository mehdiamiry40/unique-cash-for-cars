{
  "name": "unique",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:urls && npm test",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.0",
    "@types/mdx": "^2.0.14",
    "next": "16.3.0",
    "postcss": "8.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "es-abstract": "^1.24.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
